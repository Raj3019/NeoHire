PORT = 3000

MONGODB_URL=your mongodb url
# Optional: use public DNS when the local resolver refuses Atlas SRV lookups
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

JWT_TOKEN_Secret= token

GROQAPIKEY=groq api key

CLOUDINARY_CLOUD_NAME=cloudinaryCloudName

CLOUDINARY_API_KEY=cloudinaryAPIKEY

CLOUDINARY_API_SECRET=CloudinaryAPISecret

RESEND_API_KEY=ResendAPIKey

FRONTEND_URL=frontendURL

AUTO_APPLY_CRON_JOB=AutoApplyCronJob

TALENT_RADAR_CRON_JOB=TalentRadarCronJob

NODE_ENV=development
# NODE_ENV=production

# Usage Limits (per user, monthly, set -1 for unlimited)
MAX_JOBS_PER_RECRUITER=5
MAX_APPLICATIONS_PER_EMPLOYEE=5
MAX_RESUME_ROASTS_PER_USER=3
MAX_TALENT_RADAR_ALERTS_PER_RECRUITER=3

# Safe, idempotent demo seed (npm run seed:demo)
# SEED_DEMO_DATA=true
# ALLOW_PRODUCTION_DEMO_SEED=true
# DEMO_SEED_EMAIL_DOMAIN=demo.neohire.site
# Optional public demo overrides; defaults to NeoHireDemo@2026
# DEMO_CANDIDATE_PASSWORD=NeoHireDemo@2026
# DEMO_RECRUITER_PASSWORD=NeoHireDemo@2026
# Required and private; never display the admin password publicly
# DEMO_ADMIN_PASSWORD=replace-with-at-least-12-characters
# DEMO_RESUME_URL=https://your-cdn.example/demo-resume.pdf
# DEMO_PROFILE_IMAGE_URL=/avatar.png
